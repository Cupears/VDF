@page "/"
@rendermode InteractiveServer
@inject ScanService Scan
@inject FFmpegSetupService FFmpegSetup
@implements IDisposable

<PageTitle>Scan — Video Duplicate Finder</PageTitle>

<div class="scan-page-heading"><div><span class="eyebrow">YOUR LIBRARY, WITHOUT THE COPIES</span><h1>Set up your scan</h1>
    <p class="page-intro">Choose folders, pick what you want to find, then review the matches.</p></div>
    <nav class="scan-steps" aria-label="Scan steps"><span class="@(Scan.State is ScanState.Scanning or ScanState.Comparing ? "" : "active")"><b>1</b> Set up</span><span class="@(Scan.State is ScanState.Scanning or ScanState.Comparing ? "active" : "")"><b>2</b> Scan</span><a href="/results"><b>3</b> Review</a></nav>
</div>
<SettingsSyncStatus OnSynced="RefreshSharedSettings" />
@if (Scan.DesktopStartScan != null) {
    <p class="page-intro"><strong>Connected to your VDF desktop GUI.</strong> Both screens use the same scan engine and saved database. Progress, results and checked files are live. Keep VDF open on the PC.</p>
}

@* FFmpeg setup banner *@
@if (FFmpegSetup.State == FFmpegSetupState.Checking) {
    <div class="ffmpeg-banner checking">
        <span class="spinner"></span>
        Checking FFmpeg availability...
    </div>
}
@if (FFmpegSetup.State == FFmpegSetupState.Downloading) {
    <div class="ffmpeg-banner downloading">
        <span class="spinner"></span>
        <span>@FFmpegSetup.StatusMessage</span>
        <div class="progress-bar-track inline-bar">
            <div class="progress-bar-fill" style="width:@FFmpegSetup.DownloadProgress.ToString("F0")%"></div>
        </div>
    </div>
}
@if (FFmpegSetup.State == FFmpegSetupState.DockerWarning) {
    <div class="ffmpeg-banner warning">
        <strong>FFmpeg not found</strong>
        <p>@FFmpegSetup.StatusMessage</p>
    </div>
}
@if (FFmpegSetup.State == FFmpegSetupState.Failed) {
    <div class="ffmpeg-banner failed">
        <div>
            <strong>FFmpeg download failed</strong>
            <p>@FFmpegSetup.StatusMessage</p>
        </div>
        <button @onclick="RetryFfmpegSetup">Retry</button>
    </div>
}

@if (Scan.State == ScanState.Error) {
    <div class="error-box">
        <strong>Error</strong>
        <p>@Scan.ErrorMessage</p>
        <button @onclick="Scan.Reset">Dismiss</button>
    </div>
}

@if (Scan.State == ScanState.Scanning || Scan.State == ScanState.Comparing) {
    <div class="progress-section">
        <span class="eyebrow">SCAN IN PROGRESS</span><h2>@(Scan.State == ScanState.Comparing ? "Finding matches" : "Reading and sampling files")</h2>
        @if (Scan.State == ScanState.Scanning) {
            <p class="state-label">Hashing files...</p>
            @if (Scan.LastProgress is { } p && p.Max > 0) {
                int pct = (int)(100L * p.Current / p.Max);
                <div class="progress-bar-track">
                    <div class="progress-bar-fill" style="width:@pct%"></div>
                </div>
                <div class="scan-stat-grid"><div><small>Files processed</small><strong>@p.Current.ToString("N0") / @p.Max.ToString("N0")</strong></div><div><small>Elapsed</small><strong>@FormatEta(p.Elapsed)</strong></div><div><small>Time left</small><strong>@FormatEta(p.Remaining)</strong></div></div>
                <p class="file-path">@TruncatePath(p.CurrentFile, 80)</p>
                @if (!string.IsNullOrEmpty(p.CurrentStage)) {
                    <p class="stage-label">
                        @p.CurrentStage@(p.StageMax > 0 ? $" ({p.StageCurrent}/{p.StageMax})" : "")
                    </p>
                }
            }
        }
        else {
            <p class="state-label">
                <span class="spinner"></span>
                Comparing @(Scan.FilesHashed > 0 ? $"{Scan.FilesHashed:N0} hashed files" : "files") for duplicates...
            </p>
            <p class="comparing-note">This may take a while depending on library size.</p>
        }
        <div class="actions">
            <button @onclick="Scan.Pause">Pause</button>
            <button @onclick="Scan.Resume">Resume</button>
            <button class="danger" @onclick="Scan.Stop">Stop</button>
        </div>
    </div>
}
else {
    <div class="scan-setup-layout">
    <section class="scan-config scan-folders">
        <div class="page-heading"><div><span class="eyebrow">WHERE TO LOOK</span><h2>Folders to scan</h2></div><span class="folder-count">@Scan.Settings.IncludeList.Count folders</span></div>
        <p class="section-help">Add folders from this PC. Browse opens the PC's folders, including available drives.</p>
        <div class="path-list">
            @foreach (var path in Scan.Settings.IncludeList.ToList()) {
                bool valid = Directory.Exists(path);
                <div class="path-entry">
                    <span class="path-status @(valid ? "valid" : "invalid")" title="@(valid ? "Accessible" : "Not found or not accessible")">@(valid ? "\u2713" : "\u2717")</span>
                    <span class="folder-path">@path<small>@(valid ? "Ready to scan" : "Folder is not available on this PC")</small></span>
                    <button aria-label="@($"Remove {path}")" @onclick="() => RemoveInclude(path)">&#x2715;</button>
                </div>
            }
        </div>
        <div class="add-path">
            <input @bind="_newInclude" @bind:event="oninput" @onkeydown="OnIncludeKeyDown"
                   aria-label="Folder to scan" placeholder="Folder path on your PC" class="@PathInputClass(_newInclude)" />
            <button @onclick="AddInclude" disabled="@string.IsNullOrWhiteSpace(_newInclude)">Add</button>
            <button class="browse-btn" @onclick="() => _includeBrowser?.Open(string.IsNullOrWhiteSpace(_newInclude) ? null : _newInclude) ?? Task.CompletedTask">Browse…</button>
        </div>

        <h3>Folders to skip</h3><p class="section-help">Keep these folders out of the scan.</p>
        <div class="path-list">
            @foreach (var path in Scan.Settings.BlackList.ToList()) {
                bool valid = Directory.Exists(path);
                <div class="path-entry">
                    <span class="path-status @(valid ? "valid" : "invalid")" title="@(valid ? "Accessible" : "Not found")">@(valid ? "\u2713" : "\u2717")</span>
                    <span>@path</span>
                    <button @onclick="() => Scan.Settings.BlackList.Remove(path)">&#x2715;</button>
                </div>
            }
        </div>
        <div class="add-path">
            <input @bind="_newExclude" @bind:event="oninput" @onkeydown="OnExcludeKeyDown"
                   aria-label="Folder to skip" placeholder="Folder path to skip" />
            <button @onclick="AddExclude" disabled="@string.IsNullOrWhiteSpace(_newExclude)">Add</button>
            <button class="browse-btn" @onclick="() => _excludeBrowser?.Open(string.IsNullOrWhiteSpace(_newExclude) ? null : _newExclude) ?? Task.CompletedTask">Browse…</button>
        </div>

        <FolderBrowser @ref="_includeBrowser" Title="Choose a folder to scan" SavedFolders="Scan.Settings.IncludeList" OnFolderSelected="OnIncludeFolderSelected" />
        <FolderBrowser @ref="_excludeBrowser" Title="Choose a folder to skip" SavedFolders="Scan.Settings.IncludeList" OnFolderSelected="OnExcludeFolderSelected" />
        <div class="scan-quick-options">
            <label><input type="checkbox" @bind="Scan.Settings.IncludeSubDirectories" />Include subfolders</label>
            <label><input type="checkbox" @bind="Scan.Settings.IncludeImages" />Include images alongside videos</label>
        </div>
    </section>
    <aside class="scan-options">
        <ScanPresetPicker Revision="Scan.SettingsRevision" Changed="RefreshSharedSettings" />
        <section class="scan-ready">
            <span class="eyebrow">READY WHEN YOU ARE</span><h2>Scan summary</h2>
            <dl><div><dt>Folders</dt><dd>@Scan.Settings.IncludeList.Count included · @Scan.Settings.BlackList.Count skipped</dd></div>
                <div><dt>Profile</dt><dd>@VDF.Core.Utils.ScanPresets.Detect(Scan.Settings)</dd></div>
                <div><dt>Matching</dt><dd>@(Scan.Settings.CombineGrayscaleAndPHash ? "Grayscale + pHash" : Scan.Settings.UsePHashing ? "pHash" : "Grayscale") · @Scan.Settings.Percent% similarity</dd></div>
                <div><dt>Frames per video</dt><dd>@Scan.Settings.ThumbnailCount</dd></div>
                <div><dt>AI matching</dt><dd>@(Scan.Settings.NeedsAiComponents ? "On · runs on your PC" : "Off")</dd></div>
                <div><dt>Slow disk limit</dt><dd>@Scan.Settings.HddMaxDegreeOfParallelism files at once</dd></div>
            </dl><a href="/settings">Fine-tune settings →</a>

        <div class="start-row">
            @if (Scan.State == ScanState.Done || Scan.State == ScanState.Aborted || Scan.State == ScanState.Error) {
                <button @onclick="Scan.Reset">Reset</button>
            }
            <button @onclick="SaveSettings" title="Save current settings to disk">Save settings</button>
            <button class="primary" @onclick="Scan.StartScanAndCompare"
                    disabled="@(Scan.Settings.IncludeList.Count == 0 || !FFmpegSetup.IsReady)">
                Start Scan
            </button>
        </div>

        @if (_saveMsg != null) {
            <p class="@(_saveFailed ? "aborted-msg" : "done-msg")">@_saveMsg</p>
        }
        @if (Scan.State == ScanState.Done) {
            <p class="done-msg">Scan complete — <a href="/results">view @Scan.Duplicates.Count result(s)</a></p>
        }
        @if (Scan.State == ScanState.Aborted) {
            <p class="aborted-msg">Scan was stopped.</p>
        }
        </section>
    </aside>
    </div>
}

@code {
    void RefreshSharedSettings() => StateHasChanged();
    string _newInclude = string.Empty;
    string _newExclude = string.Empty;
    FolderBrowser? _includeBrowser;
    FolderBrowser? _excludeBrowser;
    string? _saveMsg;
    bool _saveFailed;

    protected override void OnInitialized() {
        Scan.SyncSharedSettings();
        Scan.StateChanged += OnStateChanged;
        FFmpegSetup.StateChanged += OnStateChanged;
    }

    void OnStateChanged() {
        try { _ = InvokeAsync(StateHasChanged); }
        catch { }
    }

    void RetryFfmpegSetup() => _ = FFmpegSetup.CheckAndSetupAsync();

    void AddInclude() {
        var path = _newInclude.Trim();
        if (!string.IsNullOrEmpty(path)) {
            Scan.Settings.IncludeList.Add(path);
            _newInclude = string.Empty;
        }
    }

    void OnIncludeFolderSelected(string path) {
        if (!Scan.Settings.IncludeList.Contains(path))
            Scan.Settings.IncludeList.Add(path);
    }

    void OnExcludeFolderSelected(string path) {
        if (!Scan.Settings.BlackList.Contains(path))
            Scan.Settings.BlackList.Add(path);
    }

    void RemoveInclude(string path) {
        Scan.Settings.IncludeList.Remove(path);
    }

    void AddExclude() {
        var path = _newExclude.Trim();
        if (!string.IsNullOrEmpty(path)) {
            Scan.Settings.BlackList.Add(path);
            _newExclude = string.Empty;
        }
    }

    void OnIncludeKeyDown(KeyboardEventArgs e) {
        if (e.Key == "Enter") AddInclude();
    }

    void OnExcludeKeyDown(KeyboardEventArgs e) {
        if (e.Key == "Enter") AddExclude();
    }

    string PathInputClass(string path) {
        if (string.IsNullOrWhiteSpace(path)) return string.Empty;
        return Directory.Exists(path.Trim()) ? "input-valid" : "input-invalid";
    }

    void SaveSettings() {
        bool ok = Scan.SaveSettings();
        _saveMsg = ok ? "Settings saved." : "Failed to save settings.";
        _saveFailed = !ok;
        _ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() => {
            _saveMsg = null;
            StateHasChanged();
        }));
    }

    static string FormatEta(TimeSpan eta) =>
        eta == TimeSpan.Zero ? "..." : eta.TotalHours >= 1 ? eta.ToString(@"h\hmm\mss\s") : eta.ToString(@"m\mss\s");

    static string TruncatePath(string path, int max) =>
        path.Length <= max ? path : "..." + path[^(max - 3)..];

    public void Dispose() {
        Scan.StateChanged -= OnStateChanged;
        FFmpegSetup.StateChanged -= OnStateChanged;
    }
}
