@rendermode InteractiveServer
@implements IDisposable
@inject IFolderBrowserSource BrowserSource
@inject IJSRuntime JS

@if (_visible) {
    var filtered = _entries.Where(e => string.IsNullOrWhiteSpace(_search) || e.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
    <div class="folder-overlay" @onclick="Close"></div>
    <div class="folder-browser folder-picker" role="dialog" aria-modal="true" aria-labelledby="@_titleId" tabindex="-1" @ref="_dialog" @onkeydown="OnDialogKeyDown">
        <div class="folder-header"><div><span class="eyebrow">FOLDERS ON YOUR PC</span><h3 id="@_titleId">@Title</h3><p>Tap once to open a folder, then choose “Use this folder”.</p></div>
            <button class="compare-close" aria-label="Close folder browser" @onclick="Close">✕</button></div>
        <div class="folder-picker-toolbar">
            <button aria-label="Back" title="Back" disabled="@(_back.Count == 0 || _loading)" @onclick="GoBack">←</button>
            <button aria-label="Parent folder" title="Parent folder" disabled="@(_currentPath == null || _loading)" @onclick="GoUp">↑</button>
            <button @onclick="() => Navigate(null)" disabled="@_loading">This PC</button>
            <button aria-label="Refresh folders" title="Refresh" @onclick="Refresh" disabled="@_loading">↻</button>
        </div>
        <div class="folder-path-bar"><input aria-label="Folder path on this PC" type="text" @bind="_pathInput" @bind:event="oninput" @onkeydown="OnPathKeyDown" placeholder="Paste a PC folder path or network share…" spellcheck="false" />
            <button class="folder-go" @onclick="GoToTypedPath" disabled="@_loading">Go</button></div>
        <nav class="folder-breadcrumbs" aria-label="Folder location"><button @onclick="() => Navigate(null)">This PC</button>
            @foreach (var part in Breadcrumbs()) { <span aria-hidden="true">›</span><button @onclick="() => Navigate(part.Path)">@part.Name</button> }
        </nav>
        <div class="folder-picker-content">
            <aside class="folder-places" aria-label="Quick locations"><span class="eyebrow">QUICK LOCATIONS</span>
                @foreach (var place in Places()) { <button @onclick="() => Navigate(place.Path)" title="@place.Path">@place.Name</button> }
                @if (SavedFolders.Any()) {
                    <span class="eyebrow">YOUR SCAN FOLDERS</span>
                    @foreach (var path in SavedFolders.Distinct(StringComparer.OrdinalIgnoreCase).Take(8)) { <button @onclick="() => Navigate(path)" title="@path">@FolderName(path)</button> }
                }
            </aside>
            <div class="folder-main">
                <div class="folder-search-row"><input aria-label="Filter folders" type="search" @bind="_search" @bind:event="oninput" @bind:after="ResetCount" placeholder="Filter folders here…" />
                    <label><input type="checkbox" @bind="_showHidden" @bind:after="Refresh" />Hidden</label></div>
                @if (_error != null) { <div class="folder-error" role="alert">@_error</div> }
                <div class="folder-list" aria-busy="@_loading">
                    @if (_loading) { <div class="folder-empty" role="status"><span class="spinner"></span> Loading folders…</div> }
                    else {
                        @foreach (var entry in filtered.Take(_displayCount)) {
                            <button class="folder-row @(entry.IsDrive ? "drive" : "")" disabled="@(!entry.IsReady)" @onclick="() => Navigate(entry.Path)" title="@entry.Path">
                                <span class="folder-icon" aria-hidden="true">@(entry.IsDrive ? "▣" : "📁")</span>
                                <span class="folder-row-body"><strong>@entry.Name</strong><small>@(entry.IsDrive ? entry.Detail : entry.Path)</small>
                                    @if (entry.UsedPercent.HasValue) { <span class="drive-capacity" aria-label="@($"{entry.UsedPercent}% used")"><span style="width:@(entry.UsedPercent)%"></span></span> }</span>
                                <span class="folder-chevron" aria-hidden="true">›</span>
                            </button>
                        }
                        @if (filtered.Count == 0) { <div class="folder-empty">@(string.IsNullOrWhiteSpace(_search) ? "No subfolders here. You can still use this folder." : "No folders match your filter.")</div> }
                        @if (filtered.Count > _displayCount) { <button class="folder-show-more" @onclick="() => _displayCount += PageSize">Show more (@(filtered.Count - _displayCount) remaining)</button> }
                    }
                </div>
                <div class="folder-list-count">@filtered.Count @(string.IsNullOrEmpty(_currentPath) ? "drives" : "folders") · folders only</div>
            </div>
        </div>
        <div class="folder-footer"><div class="folder-selected"><small>SELECTED FOLDER</small><strong title="@_currentPath">@(_currentPath ?? "Open a drive or choose a folder")</strong></div>
            <div class="folder-footer-actions"><button @onclick="Close">Cancel</button><button class="primary folder-use" @onclick="SelectCurrent" disabled="@(_currentPath == null || _loading)">Use this folder</button></div></div>
    </div>
}

@code {
    [Parameter] public EventCallback<string> OnFolderSelected { get; set; }
    [Parameter] public string Title { get; set; } = "Choose a folder";
    [Parameter] public IEnumerable<string> SavedFolders { get; set; } = Array.Empty<string>();
    const int PageSize = 80;
    readonly string _titleId = "folder-title-" + Guid.NewGuid().ToString("N");
    readonly Stack<string?> _back = new();
    IReadOnlyList<FolderBrowserEntry> _entries = Array.Empty<FolderBrowserEntry>();
    bool _visible, _loading, _showHidden, _hasLocation, _focusRequested;
    string? _currentPath, _error;
    string _pathInput = string.Empty, _search = string.Empty;
    int _displayCount = PageSize, _navigationVersion;
    CancellationTokenSource? _navigation;
    ElementReference _dialog;

    public async Task Open(string? initialPath = null) {
        _visible = true; _error = null; _search = string.Empty; _back.Clear(); _focusRequested = true;
        await Navigate(initialPath ?? _currentPath, false);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!_visible || !_focusRequested) return;
        _focusRequested = false;
        try { await _dialog.FocusAsync(); await JS.InvokeVoidAsync("vdf.initFolderPicker", _dialog); } catch { }
    }
    void Close() { _navigationVersion++; _navigation?.Cancel(); _visible = false; _loading = false; StateHasChanged(); }
    async Task Navigate(string? path, bool remember = true) {
        _navigation?.Cancel(); _navigation?.Dispose(); _navigation = new();
        int version = ++_navigationVersion;
        _loading = true; _error = null; StateHasChanged();
        try {
            var snapshot = await BrowserSource.ReadAsync(path, _showHidden, _navigation.Token);
            if (version != _navigationVersion || !_visible) return;
            if (remember && _hasLocation && !string.Equals(_currentPath, snapshot.Path, StringComparison.OrdinalIgnoreCase)) _back.Push(_currentPath);
            if (!string.Equals(_currentPath, snapshot.Path, StringComparison.OrdinalIgnoreCase)) _search = string.Empty;
            _currentPath = snapshot.Path; _pathInput = snapshot.Path ?? string.Empty; _entries = snapshot.Entries;
            _hasLocation = true; ResetCount();
        } catch (OperationCanceledException) { }
        catch (Exception ex) { if (version == _navigationVersion) _error = ex is UnauthorizedAccessException ? "You do not have access to that folder. Your current selection is unchanged." : ex.Message; }
        finally { if (version == _navigationVersion) { _loading = false; StateHasChanged(); } }
    }
    Task Refresh() => Navigate(_currentPath, false);
    Task GoToTypedPath() => string.IsNullOrWhiteSpace(_pathInput) ? Navigate(null) : Navigate(_pathInput);
    Task GoBack() => _back.Count == 0 ? Task.CompletedTask : Navigate(_back.Pop(), false);
    Task GoUp() => _currentPath == null ? Task.CompletedTask : Navigate(Directory.GetParent(_currentPath)?.FullName);
    Task OnPathKeyDown(KeyboardEventArgs e) => e.Key == "Enter" ? GoToTypedPath() : Task.CompletedTask;
    void OnDialogKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") Close(); }
    void ResetCount() => _displayCount = PageSize;
    async Task SelectCurrent() {
        if (_loading || _currentPath == null) return;
        if (!Directory.Exists(_currentPath)) { _error = "This folder is no longer available. Refresh or choose another folder."; return; }
        await OnFolderSelected.InvokeAsync(_currentPath); Close();
    }
    static string FolderName(string path) => System.IO.Path.GetFileName(path.TrimEnd(System.IO.Path.DirectorySeparatorChar, System.IO.Path.AltDirectorySeparatorChar)) is { Length: > 0 } name ? name : path;
    IEnumerable<(string Path, string Name)> Breadcrumbs() {
        var parts = new List<(string Path, string Name)>();
        if (_currentPath == null) return parts;
        for (var directory = new DirectoryInfo(_currentPath); directory != null; directory = directory.Parent) parts.Add((directory.FullName, FolderName(directory.FullName)));
        parts.Reverse(); return parts;
    }
    static IEnumerable<(string Path, string Name)> Places() {
        string home = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
        var paths = new[] { (home, "Home"), (System.IO.Path.Combine(home, "Downloads"), "Downloads"), (Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "Documents"), (Environment.GetFolderPath(Environment.SpecialFolder.DesktopDirectory), "Desktop") };
        return paths.Where(p => !string.IsNullOrEmpty(p.Item1) && Directory.Exists(p.Item1));
    }
    public void Dispose() { _navigationVersion++; _navigation?.Cancel(); _navigation?.Dispose(); }
}
