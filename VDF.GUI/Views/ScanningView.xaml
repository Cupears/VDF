<UserControl
    x:Class="VDF.GUI.Views.ScanningView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
    xmlns:data="clr-namespace:VDF.GUI.Data;assembly=VDF.GUI"
    xmlns:local="clr-namespace:VDF.GUI;assembly=VDF.GUI"
    xmlns:vm="clr-namespace:VDF.GUI.ViewModels;assembly=VDF.GUI"
    x:DataType="vm:MainWindowVM">

  <!-- Mockup .scancard: centered 780px column; counts + remaining top-right,
       elapsed + current file directly under the bar, bordered trust note.
       The log tail lives OUTSIDE the card and stretches with the window so long
       paths and remediation hints are not clipped to 780px (#836). -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid RowDefinitions="Auto,Auto,Auto">
    <StackPanel
        Grid.Row="0"

        MaxWidth="900"
        Margin="24,24,24,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top">

      <TextBlock FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"
                 Text="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Title]}" />
      <TextBlock FontSize="13" Margin="0,0,0,12" TextWrapping="Wrap" Text="{Binding ScanStageText}" />
      <Border Padding="12" CornerRadius="9" Background="{actipro:ThemeResource Container2BackgroundBrush}" ToolTip.Tip="{Binding FolderEta.Note}"
              BorderBrush="{actipro:ThemeResource Container3BorderBrush}" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock FontSize="11" FontWeight="SemiBold" Opacity="{DynamicResource VdfTextDim80Opacity}" TextWrapping="Wrap" Text="ACTIVE FOLDER / TASK" />
          <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ActiveScanFolder}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
            <TextBlock FontSize="26" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding FolderEta.Remaining}"
                       AutomationProperties.Name="Estimated time left in current step" />
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock FontSize="11" Opacity="{DynamicResource VdfTextDim80Opacity}" Text="FOLDER FINISH · PC TIME" />
              <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding FolderEta.Finish}" />
            </StackPanel>
          </Grid>
          <ProgressBar Height="9" CornerRadius="4" Minimum="0" Maximum="100"
                       Foreground="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}"
                       Value="{Binding FolderEta.Progress}" IsIndeterminate="{Binding FolderEta.UnknownTotal}"
                       AutomationProperties.Name="Current step progress" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Spacing="4">
              <TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding FolderEta.Count}" />
              <TextBlock FontSize="12" Opacity="{DynamicResource VdfTextDim80Opacity}"><Run Text="Folder time: " /><Run Text="{Binding FolderEta.Elapsed}" /></TextBlock>
            </StackPanel>
            <TextBlock Grid.Column="1" FontSize="22" FontWeight="SemiBold" Text="{Binding FolderEta.Percent}" />
          </Grid>
        </StackPanel>
      </Border>
      <StackPanel Spacing="4" Margin="0,12,0,0">
        <TextBlock FontSize="11" Opacity="{DynamicResource VdfTextDim80Opacity}" Text="LATEST FILE OR FOLDER" />
        <TextBlock FontSize="12" FontFamily="Cascadia Mono,Consolas,monospace"
                   TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding ScanCurrentFile}" Text="{Binding ScanCurrentFile}" />
      </StackPanel>
      <!-- per-drive rows (mockup .drives): label + type chip | byte-weighted bar | files stat.
           Present only while the analysis phase reports drive data; compare phases carry none. -->
      <ItemsControl
          Margin="0,26,0,0"
          AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[A11y.Scan.Drives]}"
          IsVisible="{Binding ScanDrives.HasRows}"
          ItemsSource="{Binding ScanDrives.Rows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="data:ScanDriveRow">
            <Grid ColumnDefinitions="200,*,150">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                           Text="{Binding Root}" />
                <Border CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                        BorderBrush="{actipro:ThemeResource Container3BorderBrush}"
                        BorderThickness="1"
                        IsVisible="{Binding HasType}">
                  <TextBlock FontSize="10.5" FontWeight="Bold" LetterSpacing="0.6" Opacity="{DynamicResource VdfTextFaintOpacity}"
                             Text="{Binding TypeLabel}" />
                </Border>
              </StackPanel>
              <ProgressBar Grid.Column="1" Height="7" CornerRadius="3.5" Margin="14,0"
                           AutomationProperties.Name="{Binding Root}"
                           VerticalAlignment="Center"
                           Maximum="1"
                           Value="{Binding Fraction, Mode=OneWay}" />
              <TextBlock Grid.Column="2" FontSize="12" Opacity="{DynamicResource VdfTextDim80Opacity}"
                         VerticalAlignment="Center" TextAlignment="Right"
                         Text="{Binding Stat}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- actions + bordered trust note -->
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,26,0,0">
        <Button
            x:Name="PauseButton"
            FontSize="13" Padding="16,7" VerticalAlignment="Center"
            AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Pause]}"
            Command="{Binding PauseScanCommand}"
            IsVisible="{Binding !IsPaused}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="⏸" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Pause]}" />
          </StackPanel>
        </Button>
        <Button
            x:Name="ResumeButton"
            FontSize="13" Padding="16,7" VerticalAlignment="Center"
            AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Resume]}"
            Command="{Binding ResumeScanCommand}"
            IsVisible="{Binding IsPaused}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="▶" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Resume]}" />
          </StackPanel>
        </Button>
        <Button
            FontSize="13" Padding="16,7" VerticalAlignment="Center"
            AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Stop]}"
            Command="{Binding StopScanCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="⏹" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Source={x:Static local:App.Lang}, Path=[Scan.Stop]}" />
          </StackPanel>
        </Button>
        <Border CornerRadius="8" Padding="14,7"
                BorderBrush="{actipro:ThemeResource Container3BorderBrush}"
                BorderThickness="1">
          <TextBlock FontSize="12.5" Opacity="{DynamicResource VdfTextMutedOpacity}" VerticalAlignment="Center"
                     Text="{Binding Source={x:Static local:App.Lang}, Path=[Scan.PauseNote]}" />
        </Border>
      </StackPanel>

    </StackPanel>

    <!-- last few log lines (mockup .logtail): full window width, hover for the
         complete message (#836) -->
    <Border Grid.Row="1" Margin="32,26,32,24" Padding="0,12,0,0"
            VerticalAlignment="Top"
            BorderBrush="{actipro:ThemeResource Container3BorderBrush}"
            BorderThickness="0,1,0,0">
      <StackPanel Spacing="8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Open full log" Command="{Binding ShowShellViewCommand}" CommandParameter="Log" />
        <TextBlock VerticalAlignment="Center" Text="Live activity · long tasks report every 10 seconds" TextWrapping="Wrap" />
      </DockPanel>
      <ItemsControl ItemsSource="{Binding LogTail}"
                    AutomationProperties.Name="{Binding Source={x:Static local:App.Lang}, Path=[MainWindow.Tab.Log]}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="data:LogTailRow">
            <TextBlock FontSize="11.5" Opacity="{DynamicResource VdfTextFaintOpacity}" Margin="0,1.5"
                       TextTrimming="CharacterEllipsis" Text="{Binding Display}">
              <ToolTip.Tip>
                <TextBlock MaxWidth="800" TextWrapping="Wrap" Text="{Binding Tooltip}" />
              </ToolTip.Tip>
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Margin="24,0,24,18" Padding="12" CornerRadius="8"
            Background="{actipro:ThemeResource Container2BackgroundBrush}">
      <StackPanel Spacing="6">
        <TextBlock Text="OVERALL SELECTED SCAN · CURRENT STEP" FontSize="10" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel><TextBlock Text="{Binding ScanEta.Count}" FontSize="12" /><TextBlock FontSize="11"><Run Text="Elapsed scan time: " /><Run Text="{Binding ScanEta.Elapsed}" /></TextBlock></StackPanel>
          <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold"><Run Text="{Binding ScanEta.Percent}" /><Run Text=" · " /><Run Text="{Binding ScanEta.Remaining}" /></TextBlock>
        </Grid>
        <ProgressBar Height="7" Maximum="100" Value="{Binding ScanEta.Progress}" IsIndeterminate="{Binding ScanEta.UnknownTotal}"
                     Foreground="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}" AutomationProperties.Name="Overall selected scan progress" />
        <TextBlock Text="{Binding ScanEta.Note}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
  </ScrollViewer>
</UserControl>
